# Public https address of the FastAPI server. No trailing slash.
# This value is baked in when the site is built. After changing it, redeploy.
# Do not use a private hostname such as *.railway.internal — Vercel will refuse it.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Only if API_KEY is set on the backend. Must be the same value.
NEXT_PUBLIC_API_KEY=
