# Places API (New) key. Enable "Places API (New)" in Google Cloud, then create an API key.
GOOGLE_MAPS_API_KEY=your_places_api_key_here

# Service account key for Sheets + Drive. Paste the JSON on one line, or base64-encode it.
# Enable "Google Sheets API" and "Google Drive API" for this service account's project.
GOOGLE_SERVICE_ACCOUNT_JSON=your_base64_or_raw_json_here

# Your Google account. The exported sheet is shared with this address as an editor.
# Leave it empty and the sheet link is editable by anyone who has it.
GOOGLE_SHEET_SHARE_EMAIL=you@gmail.com

# Optional. When set, the browser must send the same value as X-API-Key.
API_KEY=

# Local Postgres from docker compose. Railway may inject postgres://...?sslmode=require — that is accepted.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/leadforge

# Comma-separated sites allowed to call the API directly. The Vercel app proxies /api, so this is extra.
CORS_ORIGINS=http://localhost:3000,https://leadforge-tawny-rho.vercel.app

MAX_BODY_SIZE=1048576
