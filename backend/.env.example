# gosom Google Maps scraper, from docker compose. No Maps or Places API key.
MAPS_SCRAPER_API_URL=http://localhost:8080

# Optional Google Sheets export (no Maps or search API key required).
# Paste the service-account JSON on one line, or point at a file:
# GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_TAB_NAME=Leads

# Optional. When set, the browser must send the same value as X-API-Key.
API_KEY=

# Local Postgres from docker compose. Railway may inject postgres://...?sslmode=require — that is accepted.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/leadforge

# Comma-separated sites allowed to call the API directly. The Vercel app proxies /api, so this is extra.
CORS_ORIGINS=http://localhost:3000,https://leadforge-tawny-rho.vercel.app

MAX_BODY_SIZE=1048576

# Whole-city search limits. Tiles run one at a time.
# SEARCH_TILE_KM=3
# SEARCH_MAX_TILES=40
# SEARCH_MAX_SECONDS=5400
# SEARCH_EMPTY_TILES=3
# SEARCH_TILE_DEPTH=4
# SEARCH_TILE_SECONDS=180
# NOMINATIM_USER_AGENT=LeadForge/1.0 (local business search)
